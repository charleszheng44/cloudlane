[Desktop Entry]
Type=Application
Name=Cloudlane
GenericName=NetEase Cloud Music
Comment=Native music player for Omarchy
Exec=cloudlane %U
Icon=io.github.charleszheng44.Cloudlane
Terminal=false
Categories=AudioVideo;Audio;Player;Qt;
Keywords=music;netease;cloudlane;
StartupNotify=true
StartupWMClass=io.github.charleszheng44.Cloudlane
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-wav;video/mp4;
